#!/bin/zsh

set -eu

script_dir="${0:A:h}"
resources_dir="${script_dir:h}/Resources"
payload_dir="$resources_dir/payload"
version="$(/usr/bin/sed -n '1p' "$resources_dir/VERSION")"
user_home="${CIKE_USER_HOME:-$HOME}"
support_dir="$user_home/Library/Application Support/词刻"
site_dir="$support_dir/site"
runtime_dir="$support_dir/runtime"
applications_dir="$user_home/Applications"
installed_app="$applications_dir/词刻.app"
desktop_dir="$user_home/Desktop"
shortcut="$desktop_dir/词刻.app"
pid_file="$support_dir/词刻服务.pid"

show_dialog() {
  if [[ "${CIKE_NONINTERACTIVE:-0}" != "1" ]]; then
    /usr/bin/osascript -e "display dialog \"$1\" buttons {\"好\"} default button 1 with title \"词刻\"" >/dev/null 2>&1 || true
  fi
}

fail() {
  show_dialog "$1"
  exit 1
}

[[ "$(/usr/bin/uname -m)" == "arm64" ]] || fail "这个安装包支持所有 Apple Silicon Mac（M1–M5 及 Pro/Max/Ultra 机型），但当前系统未以 arm64 模式运行。"
[[ -n "$version" ]] || fail "安装包不完整：找不到版本号。"
[[ -d "$payload_dir/site" ]] || fail "安装包不完整：找不到网站文件。"
[[ -x "$payload_dir/runtime/node" ]] || fail "安装包不完整：找不到运行环境。"

install_mode="安装"
if [[ -d "$site_dir" || -e "$support_dir/version" ]]; then
  install_mode="升级"
fi

# Stop only the server previously started from this installation.
if [[ -f "$pid_file" ]]; then
  old_pid="$(/usr/bin/sed -n '1p' "$pid_file")"
  if [[ "$old_pid" =~ '^[0-9]+$' ]]; then
    old_command="$(/bin/ps -p "$old_pid" -o command= 2>/dev/null || true)"
    if [[ "$old_command" == *"$site_dir"* ]]; then
      /bin/kill "$old_pid" 2>/dev/null || true
      for attempt in {1..20}; do
        /bin/kill -0 "$old_pid" 2>/dev/null || break
        /bin/sleep 0.1
      done
    fi
  fi
fi

# Back up existing local data before changing program files.
if [[ -d "$site_dir/.wrangler" && ! -L "$site_dir/.wrangler" ]]; then
  backup_dir="$support_dir/backups/$(/bin/date '+%Y%m%d-%H%M%S')-v$version"
  /bin/mkdir -p "$backup_dir"
  /usr/bin/ditto "$site_dir/.wrangler" "$backup_dir/.wrangler" || fail "升级前的词库备份失败，已停止升级。"
fi

/bin/mkdir -p "$support_dir" "$site_dir" "$runtime_dir" "$applications_dir" "$desktop_dir"

# The release payload never contains .wrangler, so this merge keeps local data intact.
/usr/bin/ditto "$payload_dir/site" "$site_dir"
/usr/bin/ditto "$payload_dir/runtime/node" "$runtime_dir/node"
/bin/chmod 755 "$runtime_dir/node"
/bin/echo "$version" > "$support_dir/version"

if [[ -e "$installed_app" || -L "$installed_app" ]]; then
  /bin/rm -rf "$installed_app"
fi
/usr/bin/ditto "$payload_dir/词刻.app" "$installed_app"
/bin/chmod 755 "$installed_app/Contents/MacOS/launcher"

if [[ -L "$shortcut" ]]; then
  /bin/rm "$shortcut"
elif [[ -e "$shortcut" ]]; then
  shortcut="$desktop_dir/词刻快捷入口.app"
  if [[ -L "$shortcut" ]]; then
    /bin/rm "$shortcut"
  fi
fi

if [[ ! -e "$shortcut" && ! -L "$shortcut" ]]; then
  /bin/ln -s "$installed_app" "$shortcut"
fi

if [[ "${CIKE_SKIP_LAUNCH:-0}" != "1" ]]; then
  show_dialog "词刻 v$version ${install_mode}完成！桌面快捷入口已就绪，本地词库已保留。"
  /usr/bin/open "$installed_app"
fi

exit 0
